# In Range — environment configuration
# Copy to `.env` and fill real values. Never commit `.env`.

# --- Supabase (required for cloud) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# BLE correlation secrets (same on every client for an environment)
# Generate: openssl rand -hex 32
INRANGE_USER_ID_SECRET=
INRANGE_HMAC_SECRET=

# Encounter reveal delay: production=4, dual-phone lab=0
ENCOUNTER_REVEAL_DELAY_HOURS=4

# Foreground service (2nd Flutter engine) — leave false on Galaxy S9 lab
INRANGE_ENABLE_FGS=false

# iOS location residency (EXPERIMENT — leave false).
# Holds a location session while the beacon is on so the process is not
# suspended and app-owned timers keep firing. It does NOT make background BLE
# foreground-like; that hypothesis is unmeasured, and enabling it couples
# location to the beacon toggle against a recorded owner decision. Bench only.
INRANGE_LOCATION_RESIDENCY=false

# iOS subtle wake (EXPERIMENT — leave false).
# Lets the native SubtleWakeCoordinator wake the app on significant location
# change, venue-anchor region events and silent pushes, then run a bounded
# BLE burst plus a coarse geohash + hashed-BSSID venue hint upload
# (docs/SUBTLE_TRACKING_ARCHITECTURE.md, migration 0057). Read from dotenv
# directly by SubtleWakeService; there is no AppConfig getter.
INRANGE_SUBTLE_WAKE=false

# Calibration logging. MUST be true for any calibration walk.
# This one key gates ALL walk data: the Advert / WifiAp lines extract_walk.py
# parses, the lat/lon on GpsFix, and rssi_log inserts on iOS. Left false, a
# walk completes normally, uploads nothing usable, and you only find out at
# extraction time. Leave false for normal app use — it is verbose.
INRANGE_CALIB_SCAN=false

# --- BLE scan A/B arms (2026-07-27 walk) ---
# Both defaults below ARE the fix that shipped in e5d40e4. They are flags only
# so the walk can still measure whether the two effects are real on a Galaxy S9:
# e5d40e4 changed both at once, so a clean histogram tomorrow proves nothing on
# its own. Flip ONE handset to the "old" column, walk both, compare.
# Every scan start logs "BLE scan arm: ..." regardless of INRANGE_CALIB_SCAN, so
# a walk log always says which leg produced it.
#
# Scan the legacy 1M PHY only. true = fix (finding E1); false = old both-PHY
# scan, which upstream flutter_blue_plus #938 reports as 4-second blind slices
# on some Samsung phones. Receiver-side, so two phones in one room is a valid
# experiment. Android-only in effect.
INRANGE_SCAN_LEGACY_ONLY=true
#
# Minutes between scan restarts. 8 = fix (finding D7: AOSP force-downgrades a
# filtered scan after 10 min on Android 14+ and it stays downgraded for that
# scanner's life); 25 = old value. Clamped 1-60.
INRANGE_SCAN_RESTART_MINUTES=8

# Prefer server feeds when cloud is live
INRANGE_PREFER_SERVER=true

# OAuth redirect (must match Android intent-filter)
AUTH_REDIRECT_URL=io.inrange.app://login-callback

# Optional Google Web client ID (native Google Sign-In later)
GOOGLE_WEB_CLIENT_ID=

# Optional mock FCM token for register_push_token without Firebase
FCM_MOCK_TOKEN=
